{
  "schemaVersion": 1,
  "id": "combo",
  "version": "${version}",
  "name": "Combo",
  "description": "Melee combos, finishers, timed parries, stealth takedowns, stamina and directional dodges.",
  "authors": [
    "Vg34100"
  ],
  "license": "MIT",
  "icon": "assets/combo/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.vg.combo.fabric.ComboFabric"
    ],
    "client": [
      "net.vg.combo.fabric.client.ComboFabricClient"
    ],
    "modmenu": [
      "net.vg.combo.fabric.client.ComboModMenu"
    ]
  },
  "mixins": [
    "combo.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
